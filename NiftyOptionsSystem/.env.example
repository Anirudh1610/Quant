# Copy relevant values into the repo-root .env (../.env relative to this file).
# NiftyOptionsSystem reads credentials from there, not from this file.

KITE_API_KEY=your_api_key_here
KITE_API_SECRET=your_api_secret_here
# Regenerated daily via scripts/generate_access_token.py — do not hand-edit.
KITE_ACCESS_TOKEN=
